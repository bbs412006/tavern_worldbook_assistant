{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": ["jquery", "jqueryui", "lodash", "toastr", "type-fest"],
    "noEmit": true
  },
  "include": [
    "src/worldbook_assistant_build/**/*.ts",
    "src/worldbook_assistant_build/**/*.d.ts",
    "src/worldbook_assistant_build/**/*.vue",
    "util/script.ts",
